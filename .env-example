DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=slims9_bulian
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=slims-api
JWT_AUDIENCE=slims-admin
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_SESSION_TTL_SECONDS=43200
REFRESH_REMEMBER_TTL_SECONDS=2592000
# false hanya untuk development HTTP lokal; production wajib true dan HTTPS.
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BIND_ADDR=0.0.0.0:3000

# Driver penyimpanan: local (default), s3, atau disabled.
STORAGE_DRIVER=local
STORAGE_PREFIX=bibliography/covers
STORAGE_LOCAL_DIR=storage/uploads
# URL API yang dapat diakses browser. Driver local menambahkan path /media.
API_PUBLIC_URL=http://localhost:3000
# Opsional: override URL publik final untuk driver apa pun.
STORAGE_PUBLIC_BASE_URL=

# Konfigurasi berikut hanya diperlukan ketika STORAGE_DRIVER=s3.
S3_BUCKET=slims-media
S3_REGION=us-east-1
# Kosongkan untuk AWS S3. Contoh MinIO: http://127.0.0.1:9000
S3_ENDPOINT_URL=
# URL publik bucket atau CDN, tanpa slash penutup.
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/slims-media
S3_FORCE_PATH_STYLE=true
# Kredensial memakai standard AWS SDK credential chain.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
